{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Security headers — applied to every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Vary "Accept-Encoding"
		-Server
	}

	# Aggressive immutable cache for Next.js content-hashed assets.
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# Static assets shipped from /public (icons, fonts, placeholder).
	@publicAssets path /images/* /icon*.png /apple-icon.png /icon.svg /placeholder.svg /favicon.ico
	header @publicAssets Cache-Control "public, max-age=86400"

	# Service worker MUST NOT be cached at the edge: browsers re-fetch it on
	# every load to decide whether a new version is available. The manifest
	# can be short-cached.
	@serviceWorker path /sw.js
	header @serviceWorker Cache-Control "public, max-age=0, must-revalidate"

	@manifest path /manifest.webmanifest
	header @manifest Cache-Control "public, max-age=3600"

	# Restaurant detail pages are ISR'd at 5 min in Next (revalidate = 300).
	# Let edge cache them for 60s and serve stale up to 10 min while revalidating.
	# This is what saves users on flaky connections: a previously-visited page
	# loads instantly from Caddy even when the upstream is slow.
	@restaurantPage path /restaurant/*
	header @restaurantPage Cache-Control "public, max-age=60, stale-while-revalidate=600"

	# Homepage: short cache, stale-while-revalidate to keep TTFB low on
	# repeat visits. Mutations call revalidatePath("/") on the server side.
	@homepage path /
	header @homepage Cache-Control "public, max-age=30, stale-while-revalidate=300"

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}
}
